# ── Frontend environment variables ────────────────────────────────────────
# Copy this file to .env and fill in values before running npm run dev.

# Set to "true" to bypass the FastAPI backend and use demo credentials only.
# Useful when running the frontend without starting the backend server.
VITE_USE_DEMO_AUTH=false

# For a separately deployed FastAPI backend, use its public URL ending in /api.
# Keep /api when running locally with the Vite proxy or in demo-only mode.
VITE_API_BASE_URL=/api
